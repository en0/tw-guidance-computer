{
  "name": "refactor",
  "description": "Refactor Agent — aligns existing code to codespecs, behavior-preserving only",
  "prompt": "file://./prompts/refactor.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking",
    "todo_list",
    "use_subagent",
    "grep",
    "glob"
  ],
  "allowedTools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "thinking",
    "todo_list"
  ],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": [
        "src/",
        "tests/",
        ".kiro/skills/tw-team/refactors/"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "uv run pytest.*",
        "uv run mypy.*",
        "uv run ruff.*",
        "uv run python -m tools.arch_gates.*"
      ],
      "denyByDefault": true
    },
    "subagent": {
      "availableAgents": ["architect"],
      "trustedAgents": ["architect"]
    }
  },
  "resources": [
    "file://./.kiro/steering/*.md",
    "skill://./docs/codespecs/**/*.md"
  ],
  "hooks": {},
  "mcpServers": {},
  "includeMcpJson": false,
  "model": null
}
