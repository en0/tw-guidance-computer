#!/usr/bin/env bash
# Pre-commit hook: scan staged files for secrets.
# Patterns are loaded from .secret-patterns (gitignored).

set -euo pipefail

PATTERN_FILE="$(git rev-parse --show-toplevel)/.secret-patterns"
SCAN_PATHS=(".kiro/" "docs/" "src/" "tests/" "docker/" "tools/" "README.md" "CHANGELOG.md")

if [[ ! -f "$PATTERN_FILE" ]]; then
    echo "WARNING: .secret-patterns not found. Secret scanning skipped."
    echo "Create .secret-patterns with one regex per line."
    exit 0
fi

# Get staged files in scan paths only
staged_files=""
for scan_path in "${SCAN_PATHS[@]}"; do
    files=$(git diff --cached --name-only --diff-filter=ACMR -- "$scan_path" 2>/dev/null || true)
    staged_files="$staged_files $files"
done

staged_files=$(echo "$staged_files" | xargs)
if [[ -z "$staged_files" ]]; then
    exit 0
fi

failures=0

while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ -z "$pattern" || "$pattern" == \#* ]] && continue

    for file in $staged_files; do
        matches=$(git show ":$file" 2>/dev/null | grep -inP "$pattern" | grep -v "# nosec" || true)
        if [[ -n "$matches" ]]; then
            echo "ERROR: Secret pattern in $file matching: $pattern"
            echo "$matches" | head -3
            echo ""
            failures=$((failures + 1))
        fi
    done
done < "$PATTERN_FILE"

if [[ $failures -gt 0 ]]; then
    echo "========================================="
    echo "COMMIT BLOCKED: $failures secret pattern(s) found."
    echo "========================================="
    exit 1
fi
